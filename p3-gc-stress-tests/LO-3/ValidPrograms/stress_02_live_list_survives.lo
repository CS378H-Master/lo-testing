// good test case
// GC stress: a 50,000-node linked list stays reachable through a local while two million garbage objects force repeated collections; the list is then summed and checksummed
// main method return value: 0
// gc stress heap: 8388608

class Node ( int id; Node next; ) [
    Node(int i, Node n) { id = i; next = n; }
] {
    int get_id() { return id; }
    Node get_next() { return next; }
}

class Pair ( int a; int b; ) [
    Pair(int x, int y) { a = x; b = y; }
] {
    int sum() { return (a + b); }
}

class Churn ( ) [
    Churn() { ; }
] {
    int run(int n) {
        int i;
        Pair p;
        i = 0;
        while ( (i < n) ) {
            p = new Pair(i, i);
            i = (i + 1);
        }
        return i;
    }
}

class Main ( ) {
    int main() {
        Node head;
        Node cur;
        Churn c;
        int i;
        int sum;
        int hash;
        int count;
        head = null;
        i = 1;
        while ( (i < 50001) ) {
            head = new Node(i, head);
            i = (i + 1);
        }
        c = new Churn();
        i = c.run(2000000);
        sum = 0;
        hash = 7;
        count = 0;
        cur = head;
        while ( (! (cur = null)) ) {
            sum = (sum + cur.get_id());
            hash = ((hash * 31) + cur.get_id());
            count = (count + 1);
            cur = cur.get_next();
        }
        out.print_int(count);
        out.println();
        out.print_int(sum);
        out.println();
        out.print_int(hash);
        out.println();
        return 0;
    }
}
