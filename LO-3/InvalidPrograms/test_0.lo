// Note: SH, Fa26 -- student observed the current error code//  E_PARSE_PHASE_OTHER is wrong, and should be E_RESERVED_KEYWORD_AS_IDENTIFIER instead. For now, we should just remove the error code and let it remain a compile fail.

class Main() {
    int main(){
        Adder adder;
        adder = new Adder(1,2,3);
        return adder.add();
    }
}

class Adder(int a, int b, int c) [
    Adder(int A, int B, int C){
        a = A;
        b = B;
        c = C;
    }
] {
    int add(){
        return ((a + b)+c);
    }
}
