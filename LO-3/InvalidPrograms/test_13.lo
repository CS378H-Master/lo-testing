class Main() {
    int main(){
        Condition condition;
        while waiter;
        bool wait;
        condition = new Condition();
        waiter = new while(condition);
        wait = waiter.wait();
        return condition.getState();
    }
}

class Condition(int state;) [
    Condition() {
        state = 0;
    }
] {
    bool check() {
        state = (state + 1);
        return (state < 10);
    }
    int getState() {
        return state;
    }
}

class while(Condition condition;) [
    while(Condition cond) {
        condition = cond;
    }
] {
    bool wait() {
        while (condition.check()) { ; }
        return true;
    }
}
