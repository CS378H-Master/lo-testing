// good test case
// register pressure: 4 loop-carried ints, one method call in the loop body
// main method return value: 0
// expected spills: less than 15 (plus configured slack)


class Main () {
    int bump(int x) {
        return (x + 1);
    }

    int main() {
        int n, i, acc;
        int v0, v1, v2, v3;
        n = in.read_int();
        i = 0;
        v0 = 1;
        v1 = 2;
        v2 = 3;
        v3 = 4;
        while ((i < n)) {
            v0 = (v0 + v1);
            v1 = (v1 + v2);
            v2 = this.bump(v2);
            v3 = (v3 + v0);
            i = (i + 1);
        }
        acc = (((v0 + v1) + v2) + v3);
        out.print_int(acc);
        out.println();
        return 0;
    }
}
