// good test case
// register pressure: 1 loop-carried ints, no call in the loop body
// main method return value: 0
// expected spills: less than 1 (plus configured slack)


class Main () {
    int main() {
        int n, i, acc;
        int v0;
        n = in.read_int();
        i = 0;
        v0 = 1;
        while ((i < n)) {
            v0 = (v0 + 1);
            i = (i + 1);
        }
        acc = v0;
        out.print_int(acc);
        out.println();
        return 0;
    }
}
