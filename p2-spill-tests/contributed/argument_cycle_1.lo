// good test case
// contributed register-pressure test: five arguments forwarded in reverse order, a cyclic register shuffle at every call, with all five live across it
// main method return value: 0
// expected spills: less than 47 (plus configured slack)


class Main () {
    int weigh(int a, int b, int c, int d, int e) {
        return (((a + (b + b)) + ((c + c) + c)) + ((((d + d) + d) + d) + ((((e + e) + e) + e) + e)));
    }

    int reverse(int a, int b, int c, int d, int e) {
        return this.weigh(e, d, c, b, a);
    }

    int main() {
        int n, i, acc;
        int v0, v1, v2, v3, v4;
        n = in.read_int();
        i = 0;
        v0 = 1;
        v1 = 2;
        v2 = 3;
        v3 = 4;
        v4 = 5;
        while ((i < n)) {
            v0 = this.reverse(v0, v1, v2, v3, v4);
            v1 = (v1 + v0);
            v2 = (v2 + v1);
            v3 = (v3 + v2);
            v4 = (v4 + v3);
            i = (i + 1);
        }
        acc = ((((v0 + v1) + v2) + v3) + v4);
        out.print_int(acc);
        out.println();
        return 0;
    }
}
